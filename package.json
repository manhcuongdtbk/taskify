{
  "name": "taskify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:eslint && pnpm lint:routes && pnpm lint:prettier && pnpm lint:prisma && pnpm lint:types",
    "lint:fix": "pnpm lint:eslint:fix; e1=$?; pnpm lint:routes:fix; e2=$?; pnpm lint:prettier:fix; e3=$?; pnpm lint:prisma:fix; e4=$?; exit $((e1||e2||e3||e4))",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "lint:routes": "node --import tsx scripts/check-route-export-names.ts",
    "lint:routes:fix": "node --import tsx scripts/check-route-export-names.ts --fix",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:prisma": "node --import tsx scripts/check-prisma-schema.ts",
    "lint:prisma:fix": "node --import tsx scripts/check-prisma-schema.ts --fix",
    "lint:types": "tsc --noEmit",
    "lint:file-support": "node --import tsx scripts/print-lint-file-support.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:paths": "node --import tsx scripts/test-coverage-paths.ts",
    "test:inspect": "vitest --inspect-brk --no-file-parallelism --test-timeout=0",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@calcom/cal-sans-ui": "^1.3.0",
    "@clerk/nextjs": "^7.7.1",
    "@clerk/ui": "^1.29.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@next/env": "^16.2.12",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cssesc": "^3.0.0",
    "date-fns": "^4.4.0",
    "dinero.js": "^2.0.2",
    "es-toolkit": "^1.50.0",
    "lucide-react": "^1.30.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unsplash-js": "^8.0.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@noctcore/eslint-plugin-react": "^0.2.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cssesc": "^3.0.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-filename-match-export": "^1.4.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-zod": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
